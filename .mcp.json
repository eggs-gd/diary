{
	"mcpServers": {
		"svelte": {
			"type": "stdio",
			"command": "npx",
			"env": {},
			"args": ["-y", "@sveltejs/mcp"]
		},
		"design-patterns": {
			"type": "stdio",
			"command": "sh",
			"env": {},
			"args": [
				"-c",
				"AGENTS_TOOLS_DIR=\"${AGENTS_TOOLS_DIR:-$HOME/.agents}\"; exec env DATABASE_PATH=\"$AGENTS_TOOLS_DIR/design_patterns_mcp/data/design-patterns.db\" node \"$AGENTS_TOOLS_DIR/design_patterns_mcp/dist/mcp-server.js\""
			]
		},
		"ts-language": {
			"type": "stdio",
			"command": "npx",
			"env": {},
			"args": ["-y", "ts-language-mcp", "--name", "app", "App"]
		},
		"ts-language-site": {
			"type": "stdio",
			"command": "npx",
			"env": {},
			"args": ["-y", "ts-language-mcp", "--name", "site", "Site"]
		}
	}
}
